 "title": "Mini Exchange",
 "tags": [
  "mini-exchange"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Latency (the latency histograms)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "PlaceOrder latency (gateway request)",
   "description": "mx_gateway_request_seconds: gRPC handler time for PlaceOrder, from request in to response out. Target: p99 under 5 ms at 10k orders/s.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(mx_gateway_request_seconds_bucket{rpc=~\".*PlaceOrder\"}[1m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(mx_gateway_request_seconds_bucket{rpc=~\".*PlaceOrder\"}[1m])))",
     "legendFormat": "p99",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.999, sum by (le) (rate(mx_gateway_request_seconds_bucket{rpc=~\".*PlaceOrder\"}[1m])))",
     "legendFormat": "p99.9",
     "refId": "C"
    }
   ]
  },
